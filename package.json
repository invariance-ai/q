{
  "name": "@invariance/q",
  "version": "0.1.0",
  "description": "Ask a question in your terminal and get the answer back. Multi-provider LLMs that can call your own HTTP APIs as tools, with a polished interactive chat mode.",
  "type": "module",
  "bin": {
    "q": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "terminal",
    "chat",
    "anthropic",
    "openai",
    "ask"
  ],
  "author": "Invariance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invariance-ai/q.git"
  },
  "bugs": {
    "url": "https://github.com/invariance-ai/q/issues"
  },
  "homepage": "https://github.com/invariance-ai/q#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "kleur": "^4.1.5",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^6.39.0",
    "ora": "^9.4.0",
    "react": "^18.3.1",
    "supports-color": "^10.2.2",
    "wrap-ansi": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.29",
    "eslint": "^10.4.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
